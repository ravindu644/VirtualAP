# Leftovers of the build before 2026-10-30, root-owned; delete them with sudo and drop these two lines.
out/
scripts/.src-cache/
# Binaries are built from the externals/ submodules by scripts/build-static.sh
# (in CI on every run), never committed. Keep the per-arch dirs via .gitkeep.
backend/aarch64/*
!backend/aarch64/.gitkeep
backend/armhf/*
!backend/armhf/.gitkeep
Android/.gradle/
Android/build/
Android/app/build/
Android/app/src/main/assets/
*.keystore
Android/local.properties
