#!/system/bin/sh

# VirtualAP engine
# Copyright (c) 2026 ravindu644
#
# Creates a virtual AP (ap0): static gateway, DHCP+DNS via dnsmasq, selectable
# upstream ("auto" follows netd's default-network rule). The whole AP stack
# (iw/hostapd/dnsmasq) ships as fully-static aarch64 and armhf binaries under
# bin/ and runs directly on Android - no chroot, no namespaces. Routing and
# firewall use Android's own /system/bin ip + iptables.

BASE_DIR="/data/local/virtualap"
BIN_DIR="${BASE_DIR}/bin"
RUN_DIR="${BASE_DIR}/run"
CONF_FILE="${BASE_DIR}/ap.conf"
STATE_FILE="${BASE_DIR}/run.state"
LOG_FILE="${BASE_DIR}/logs/ap.log"
# Per-daemon logs so a crash/failure leaves a trace instead of vanishing (both
# daemonize and would otherwise drop their output into the void).
HOSTAPD_LOG="${BASE_DIR}/logs/hostapd.log"
DNSMASQ_LOG="${BASE_DIR}/logs/dnsmasq.log"

# Static AP-stack binaries (iw/hostapd/dnsmasq)
HOSTAPD="${BIN_DIR}/hostapd"
IW="${BIN_DIR}/iw"
DNSMASQ="${BIN_DIR}/dnsmasq"
# hostapd_cli creates its own reply socket under /tmp, which Android does not
# have, so every call needs -s pointed at a directory that exists.
hostapd_cli() { "$BIN_DIR/hostapd_cli" -s "$RUN_DIR" "$@"; }

IP="/system/bin/ip"
IPT="/system/bin/iptables"
IP6T="/system/bin/ip6tables"

# Network constants
AP_IFACE="ap0"
GW_DEFAULT="192.168.42.1"
IP_GW="$GW_DEFAULT"
IP_NET=""
IP_BEGIN=""
IP_END=""
# What dnsmasq forwards to when no -d is given. Android has no resolv.conf, and
# the phone's own resolvers may sit behind a VPN or on another interface that
# dnsmasq's queries never take, so public ones are the safe default.
DNS_DEFAULT="1.1.1.1,8.8.8.8"

# Pinned rule priorities - above netd's range (10000+), clear of Droidspaces' 6090-6100.
PRIO_TO_SUBNET=7000   # to 192.168.42.0/24 lookup main   (return path)
PRIO_FROM_AP=7010     # from all iif ap0 lookup <table>  (upstream steering)
# IPv6 only: a packet from the upstream for an address in the shared /64 that no
# client holds (yet) has no /128 in main. Without this it would take the default
# route back out and, on cellular where the PGW routes the whole /64 to us, bounce
# until its hop limit dies, 64 radio transmissions for one stray packet.
PRIO_V6_SINK=7001     # from all iif <upstream> to <our /64> blackhole
# Android kernels file an interface's own routes, fe80::/64 included, in table
# 1000+ifindex, which no rule reads, so a packet the phone itself sends to a
# client's link-local on ap0 has no route. The kernel's own neighbour discovery
# bypasses routing and works anyway; dnsmasq does not, and its answer to a
# router solicitation is a unicast RA to that link-local. Without this rule
# clients got an address only from the periodic multicast RA, minutes later.
PRIO_V6_LINK=7002     # from all oif ap0 lookup main

# Android's local_network table (constant since Android 5). We mirror the AP
# subnet here so container reply packets (src 172.28.0.0/16) hit Droidspaces'
# rule 6095 instead of leaking out WAN via 6100.
ANDROID_LOCAL_NETWORK_TABLE=97

# Droidspaces' fixed NAT subnets. In managed mode the hotspot's traffic reaches
# the host from the container's address in these.
DS_NAT_NET="172.28.0.0/16"
DS_NAT_NET6="fd64:7370::/48"

# IPv6 for hotspot clients (routed mode). Stock kernels rarely ship ip6table_nat
# and Android hands the phone one /64 (SLAAC) with no prefix delegation, so the
# clients get global addresses out of that same /64 (what Android's own tethering
# does): ap0 advertises it off-link, every client address is routed as a /128 to
# ap0 and answered for on the upstream side with an NDP proxy entry. No NAT.
IP6_NET=""            # the shared /64, "g1:g2:g3:g4::/64"
IP6_P4=""             # its first four groups, zero padded
IP6_GW=""             # ap0's own address inside it (RDNSS)
IP6_UP_IFACE=""
IP6_PREV_FWD=""
IP6_PREV_PROXY=""
IP6_ACTIVE=0

# Defaults (overridden by ap.conf, then by CLI flags)
PHY_IFACE="wlan0"
UPSTREAM="auto"
SSID=""
PASSWORD=""
BAND="2"
CHANNEL=""
WIDTH="auto"
DNS_SERVERS=""        # comma separated; empty means DNS_DEFAULT
HIDDEN="0"
# Security: open | wpa2 | wpa2wpa3 | wpa3. PMF (ieee80211w) only applies to wpa2
# (0/1); wpa2wpa3 forces 1 and wpa3 forces 2 per the standard.
SECURITY="wpa2"
PMF="0"
# Rewrite the TTL of forwarded packets so tethered traffic looks like the phone's
# own to the operator. Needs the kernel's TTL target, so it is best effort.
TTL_FIX="0"
# Hand IPv6 to the clients when the upstream interface has a global /64 prefix
# (1 = yes [default], 0 = IPv4 only). Routed mode only.
IPV6="1"

# Managed mode (a Droidspaces container). When CONTAINER is set: ap0 becomes a
# bridged port on VAP_BRIDGE, a veth peer is handed to the container as
# VAP_PORT, and the container owns all L3 (DHCP/DNS/NAT). Names are distinct
# from Droidspaces' own ds-br0/ds-lan.
CONTAINER=""
VAP_BRIDGE="vap-br0"      # host-side bridge
VAP_VETH_HOST="vap-v0"    # host-side veth (bridge port)
VAP_VETH_PEER="vap-p0"    # peer veth before it enters the container
VAP_PORT="vaplan0"        # interface name inside the container
# The LAN provisioned inside the container reuses the configured gateway/subnet
# (IP_GW / IP_NET, default 192.168.42.1) - the same one routed mode uses, so a
# custom -g gateway applies in both modes.
# VAP_PORT is the clients' gateway, and a fresh veth gets a new random MAC on
# every start. Windows keys its network profiles on the gateway's MAC, so it
# files each start as a new network and makes it Public again. A MAC here is
# kept across starts; empty leaves the random one.
GW_MAC=""

# Droidspaces CLI: prefer the install path, fall back to PATH.
if [ -x "/data/local/Droidspaces/bin/droidspaces" ]; then
    DROIDSPACES="/data/local/Droidspaces/bin/droidspaces"
else
    DROIDSPACES="droidspaces"
fi

SCRIPT_NAME="${0##*/}"

if [ -x "$BIN_DIR/busybox" ]; then
    export BUSYBOX="$BIN_DIR/busybox"
elif command -v busybox >/dev/null 2>&1; then
    export BUSYBOX="busybox"
else
    echo "[ERROR] No busybox found. Aborting." >&2
    exit 1
fi

# Route coreutils through the bundled busybox (Android's toybox is unreliable
# across phones). Each $VAR word-splits to "busybox <applet>" - never quote it.
# ip/iptables stay Android's; iw/hostapd/dnsmasq are our static binaries.
BB="$BUSYBOX"
CAT="$BB cat"
CUT="$BB cut"
DATE="$BB date"
ECHO="$BB echo"
GREP="$BB grep"
HEAD="$BB head"
ID="$BB id"
KILL="$BB kill"
MKDIR="$BB mkdir"
PING="$BB ping"
PRINTF="$BB printf"
RM="$BB rm"
SED="$BB sed"
SLEEP="$BB sleep"
TR="$BB tr"
WC="$BB wc"

$MKDIR -p "$BASE_DIR/logs" "$RUN_DIR"

log()   { $ECHO "$1";          $ECHO "[$($DATE '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }
warn()  { $ECHO "[WARN] $1";   $ECHO "[$($DATE '+%Y-%m-%d %H:%M:%S')] [WARN] $1" >> "$LOG_FILE"; }
error() { $ECHO "[ERROR] $1";  $ECHO "[$($DATE '+%Y-%m-%d %H:%M:%S')] [ERROR] $1" >> "$LOG_FILE"; }

load_conf() {
    [ -f "$CONF_FILE" ] && . "$CONF_FILE"
}

# Escape single quotes so a password with " or $ can't break out of the conf file.
sq() { $PRINTF "%s" "$1" | $SED "s/'/'\\\\''/g"; }

save_conf() {
    $CAT > "$CONF_FILE" <<EOF
PHY_IFACE='$(sq "$PHY_IFACE")'
UPSTREAM='$(sq "$UPSTREAM")'
SSID='$(sq "$SSID")'
PASSWORD='$(sq "$PASSWORD")'
BAND='$(sq "$BAND")'
CHANNEL='$(sq "$CHANNEL")'
WIDTH='$(sq "$WIDTH")'
IP_GW='$(sq "$IP_GW")'
DNS_SERVERS='$(sq "$DNS_SERVERS")'
HIDDEN='$(sq "$HIDDEN")'
SECURITY='$(sq "$SECURITY")'
PMF='$(sq "$PMF")'
TTL_FIX='$(sq "$TTL_FIX")'
IPV6='$(sq "$IPV6")'
CONTAINER='$(sq "$CONTAINER")'
GW_MAC='$(sq "$GW_MAC")'
EOF
}

# Run a command in the target container (droidspaces execvp's argv directly).
ds_run() { "$DROIDSPACES" -n "$CONTAINER" run "$@"; }

# Running containers as "name=pid" lines, parsed from `droidspaces show
# --json` JSON ({"running":[{"name":"X","pid":N,...},...]}). Each object is
# split onto its own line so a plain sed can pick the name/pid pair; no jq in
# the chroot.
ds_list() {
    "$DROIDSPACES" show --json 2>/dev/null \
        | $TR '{' '\n' \
        | $SED -n 's/^"name":"\([^"]*\)","pid":\([0-9][0-9]*\).*/\1=\2/p'
}

# PID of a running container by name, empty if not running.
ds_container_pid() {
    ds_list | $SED -n "s/^$1=//p" | $HEAD -n1
}

# True if the container's /etc/os-release identifies it as OpenWrt.
# OpenWrt writes ID="openwrt" (quoted), so tolerate optional ' or " quoting.
ds_is_openwrt() {
    ds_run cat /etc/os-release 2>/dev/null | $GREP -qiE "^ID=['\"]?openwrt"
}

detect_auto_table() {
    # netd's default-network rule = which network has internet now. First match
    # wins (rules are priority-sorted); uidrange variants are per-app VPN, skip.
    "$IP" rule show 2>/dev/null \
        | $GREP "fwmark 0x0/0xffff iif lo" \
        | $GREP -v uidrange \
        | $HEAD -n1 \
        | $SED -n 's/.*lookup \([^ ]*\).*$/\1/p'
}

table_oif() {
    # default route's outgoing interface in a given table
    "$IP" route show table "$1" 2>/dev/null \
        | $GREP '^default' | $HEAD -n1 \
        | $SED -n 's/.*dev \([^ ]*\).*/\1/p'
}

resolve_iface_table() {
    # netd names routing tables after interfaces, so a name lookup usually
    # works (incl. wg0). Fall back to scanning all tables, then to main.
    local iface="$1" tbl
    "$IP" route show table "$iface" 2>/dev/null | $GREP -q . && { $ECHO "$iface"; return 0; }
    tbl=$("$IP" route show table all 2>/dev/null \
        | $GREP " dev $iface " | $SED -n 's/.*table \([0-9]*\).*/\1/p' | $HEAD -n1)
    $ECHO "${tbl:-main}"
}

resolve_upstream() {
    # Sets UPSTREAM_TABLE and UPSTREAM_IFACE_RESOLVED
    if [ "$UPSTREAM" = "auto" ]; then
        UPSTREAM_TABLE=$(detect_auto_table)
        if [ -z "$UPSTREAM_TABLE" ]; then
            error "Could not auto-detect the upstream network (no netd default-network rule)."
            error "Select an upstream interface explicitly with -o <iface>."
            return 1
        fi
        UPSTREAM_IFACE_RESOLVED=$(table_oif "$UPSTREAM_TABLE")
        log "Auto upstream: table $UPSTREAM_TABLE${UPSTREAM_IFACE_RESOLVED:+ ($UPSTREAM_IFACE_RESOLVED)}"
    else
        if [ ! -d "/sys/class/net/$UPSTREAM" ]; then
            error "Upstream interface '$UPSTREAM' does not exist."
            return 1
        fi
        UPSTREAM_TABLE=$(resolve_iface_table "$UPSTREAM")
        UPSTREAM_IFACE_RESOLVED="$UPSTREAM"
        log "Upstream: $UPSTREAM (table $UPSTREAM_TABLE)"
    fi
    return 0
}

sta_channel() {
    # Current channel of the STA connection, empty if not connected. Derived
    # from the link frequency: Samsung's Broadcom driver omits the "channel"
    # line from `iw dev info` entirely, but `iw dev link` always has "freq:".
    local f
    f=$("$IW" dev "$PHY_IFACE" link 2>/dev/null \
        | $SED -n 's/^[[:space:]]*freq: \([0-9]*\).*/\1/p' | $HEAD -n1)
    [ -z "$f" ] && return
    # ponytail: 2.4GHz ch 14 (2484) maps wrong here; it is never usable for AP anyway.
    if [ "$f" -lt 5000 ]; then $ECHO $(( (f - 2407) / 5 )); else $ECHO $(( (f - 5000) / 5 )); fi
}

# The Wi-Fi's factory MAC, what the app's Static MAC mode starts from: the
# first of these that has it, empty when none do.
#  1. Android's Wi-Fi service (11 and up) saves the factory MAC it read from
#     the Wi-Fi HAL in its settings store, whatever the vendor or driver.
#  2. wlan0's address, but only while the kernel says nobody changed it
#     (addr_assign_type 0): Android gives wlan0 a random MAC per network.
#  3. The kernel's permanent address, which newer iproute2 prints as permaddr.
#  4. Samsung's copy in efs, which has no trailing newline and only the MAC
#     in its first 17 characters.
wifi_mac() {
    local d="/sys/class/net/$PHY_IFACE" mac
    mac=$($CAT /data/misc/apexdata/com.android.wifi/WifiConfigStore.xml \
            /data/misc/wifi/WifiConfigStore.xml 2>/dev/null \
        | $SED -n 's/.*"wifi_sta_factory_mac_address">\([0-9a-fA-F:]\{17\}\)<.*/\1/p' | $HEAD -n1)
    # A HAL that could not read it answers with zeros.
    [ "$mac" = "00:00:00:00:00:00" ] && mac=""
    [ -z "$mac" ] && [ "$($CAT "$d/addr_assign_type" 2>/dev/null)" = "0" ] \
        && mac=$($CAT "$d/address" 2>/dev/null)
    [ -z "$mac" ] && mac=$("$IP" link show "$PHY_IFACE" 2>/dev/null \
        | $SED -n 's/.* permaddr \([0-9a-fA-F:]*\).*/\1/p' | $HEAD -n1)
    [ -z "$mac" ] && mac=$($CAT /efs/wifi/.mac.info /mnt/vendor/efs/wifi/.mac.info 2>/dev/null \
        | $SED -n 's/^\([0-9a-fA-F:]\{17\}\).*/\1/p' | $HEAD -n1)
    $ECHO "$mac" | $TR 'A-F' 'a-f'
}

is_dfs_channel() {
    # 5GHz DFS range: beaconing needs radar detection - phone chips refuse
    [ "$1" -ge 52 ] 2>/dev/null && [ "$1" -le 144 ] 2>/dev/null
}

# True if the phy lists channel $1 as "no IR" (beaconing forbidden).
chan_no_ir() { phy_info | $GREP -q "\[$1\] .*no IR"; }

# Make sure the driver's regdomain allows an AP on 5GHz channel $1 (CHANNEL).
# Samsung's Broadcom FullMAC firmware boots in world country "99" and the
# framework sometimes never pushes a real code (race with telephony at boot):
# every 5GHz channel then stays NO-IR, and hostapd dies ~5s in - after our 2s
# liveness check - so the AP looks ACTIVE but never beacons. The wiphy is
# self-managed, so `iw reg set` and hostapd's country_code are ignored; the
# only lever is the driver's private COUNTRY command via the supplicant's
# control socket (no wpa_cli on phones - our hostapd_cli speaks the same
# protocol). The reply never makes it back (SELinux), so don't wait for it.
# Country: the framework's own answer (cmd wifi get-country-code is Android 11+
# and prints null before telephony has settled), falling back to US.
# $1 = STA channel (for the 2.4GHz fallback), may be empty.
WPA_CTRL_DIR="/data/vendor/wifi/wpa/sockets"
ensure_5g_ir() {
    chan_no_ir "$CHANNEL" || return 0
    local cc
    cc=$(cmd wifi get-country-code 2>/dev/null \
        | $SED -n 's/.*= *\([A-Za-z][A-Za-z]\)[[:space:]]*$/\1/p' | $TR 'a-z' 'A-Z')
    cc="${cc:-US}"
    warn "5GHz channel $CHANNEL is NO-IR (driver in world regdomain) - setting driver country to $cc."
    hostapd_cli -p "$WPA_CTRL_DIR" -i "$PHY_IFACE" raw "DRIVER COUNTRY $cc" >/dev/null 2>&1 &
    $SLEEP 1
    PHY_INFO_CACHE=""
    if chan_no_ir "$CHANNEL"; then
        CHANNEL=$([ -n "$1" ] && [ "$1" -le 14 ] && $ECHO "$1" || $ECHO 6)
        warn "Channel still NO-IR after setting country - falling back to 2.4GHz channel $CHANNEL."
    fi
}

# wiphy index of the STA radio (capabilities are per-wiphy). Empty if unknown.
phy_idx() {
    "$IW" dev "$PHY_IFACE" info 2>/dev/null \
        | $SED -n 's/.*wiphy \([0-9]*\).*/\1/p' | $HEAD -n1
}

# Cache the radio's `iw phy <phyN> info` once - it's static and a bit slow.
PHY_INFO_CACHE=""
phy_info() {
    if [ -z "$PHY_INFO_CACHE" ]; then
        local idx; idx=$(phy_idx)
        [ -n "$idx" ] && PHY_INFO_CACHE=$("$IW" phy "phy$idx" info 2>/dev/null)
    fi
    $PRINTF '%s' "$PHY_INFO_CACHE"
}

phy_supports_vht()  { phy_info | $GREP -q 'VHT Capabilities'; }
phy_supports_ht40() { phy_info | $GREP -q 'HT20/HT40'; }
# The same question for the 2.4GHz band alone (Band 1). Plenty of phone chips
# do 40MHz on 5GHz only.
phy_supports_ht40_24() {
    phy_info | $SED -n '/Band 1:/,/Band 2:/p' | $GREP -q 'HT20/HT40'
}

# 80MHz block center channel index (vht_oper_centr_freq_seg0_idx) for a primary
# 5GHz channel. Empty if the channel is not part of a valid 80MHz block.
vht_seg0() {
    local c="$1"
    if   [ "$c" -ge 36  ] && [ "$c" -le 48  ]; then $ECHO 42
    elif [ "$c" -ge 52  ] && [ "$c" -le 64  ]; then $ECHO 58
    elif [ "$c" -ge 100 ] && [ "$c" -le 112 ]; then $ECHO 106
    elif [ "$c" -ge 116 ] && [ "$c" -le 128 ]; then $ECHO 122
    elif [ "$c" -ge 132 ] && [ "$c" -le 144 ]; then $ECHO 138
    elif [ "$c" -ge 149 ] && [ "$c" -le 161 ]; then $ECHO 155
    fi
}

# HT40 secondary-channel direction (+/-) for a primary channel inside its 80MHz
# block: lower member of each 40MHz pair is '+', upper is '-'. seg0-6 is the
# block's first channel; channels step by 4 (works for UNII-3's 149/153/157/161).
ht40_dir() {
    local c="$1" seg0="$2" start off
    start=$((seg0 - 6)); off=$((c - start))
    if [ $(( (off / 4) % 2 )) -eq 0 ]; then $ECHO '+'; else $ECHO '-'; fi
}

# Resolve the effective channel width into EFFECTIVE_WIDTH (20|40|80), honoring
# the requested WIDTH but downgrading to what the band/channel/chip can do. Runs
# after pick_channel (needs the final BAND/CHANNEL).
EFFECTIVE_WIDTH="20"
pick_width() {
    local max="20" inblock
    if [ "$BAND" != "5" ]; then
        # 2.4GHz: a 40MHz channel takes up most of the band and crowds out the
        # neighbours and Bluetooth, so "auto" stays at 20MHz and 40 is only used
        # when asked for by name. Channel 14 has no room for a second channel.
        EFFECTIVE_WIDTH="20"
        [ "$WIDTH" = "40" ] && [ "$CHANNEL" -le 13 ] && phy_supports_ht40_24 && EFFECTIVE_WIDTH="40"
    else
        # Widest the chip + channel can actually do. A non-empty vht_seg0 means the
        # channel sits in a valid 40/80MHz block (excludes 20MHz-only channels like 165).
        inblock=$(vht_seg0 "$CHANNEL")
        phy_supports_ht40 && [ -n "$inblock" ] && max="40"
        phy_supports_vht  && [ -n "$inblock" ] && max="80"
        case "$WIDTH" in
            20) EFFECTIVE_WIDTH="20" ;;
            40) [ "$max" = "20" ] && EFFECTIVE_WIDTH="20" || EFFECTIVE_WIDTH="40" ;;
            *)  EFFECTIVE_WIDTH="$max" ;;       # 80 if possible, and auto = widest supported
        esac
    fi
    [ "$EFFECTIVE_WIDTH" != "$WIDTH" ] && [ "$WIDTH" != "auto" ] && \
        warn "Requested ${WIDTH}MHz but using ${EFFECTIVE_WIDTH}MHz (channel/chip limit)."
    return 0
}

# Take the STA's channel $1, warning when a different one was asked for.
follow_sta() {
    [ -n "$CHANNEL" ] && [ "$CHANNEL" != "$1" ] && \
        warn "Requested channel $CHANNEL but STA is on $1 - using $1 (same-channel concurrency)."
    CHANNEL="$1"
}

pick_channel() {
    # Most phone chips can only beacon on the STA's current channel (same-channel
    # concurrency). Follow it when it fits the band, else fall back.
    local sta_ch
    sta_ch=$(sta_channel)

    if [ "$BAND" = "5" ]; then
        if [ -n "$sta_ch" ] && [ "$sta_ch" -ge 36 ] 2>/dev/null; then
            if is_dfs_channel "$sta_ch"; then
                warn "STA is on 5GHz DFS channel $sta_ch - AP cannot beacon there. Falling back to 2.4GHz."
                BAND="2"; CHANNEL="${CHANNEL:-6}"
            else
                follow_sta "$sta_ch"
            fi
        elif [ -n "$sta_ch" ]; then
            warn "STA is on 2.4GHz (channel $sta_ch) - 5GHz AP would need different-band concurrency."
            if [ -z "$CHANNEL" ]; then
                warn "Trying 5GHz channel 36; if the AP fails to start, use band 2."
                CHANNEL="36"
            fi
        else
            # No STA connection (mobile-data upstream) - radio is free
            CHANNEL="${CHANNEL:-36}"
        fi
    elif [ -n "$sta_ch" ] && [ "$sta_ch" -le 14 ] 2>/dev/null; then
        follow_sta "$sta_ch"
    else
        CHANNEL="${CHANNEL:-6}"
    fi

    # 5GHz needs the regdomain to allow beaconing there - see ensure_5g_ir, which
    # may itself fall back to 2.4GHz, so BAND follows the final channel.
    if [ "$CHANNEL" -ge 36 ] 2>/dev/null; then ensure_5g_ir "$sta_ch"; fi
    BAND="2"; [ "$CHANNEL" -ge 36 ] 2>/dev/null && BAND="5"
}

# True if $1 is a dotted IPv4 address as inet_pton reads it: four octets of at
# most three digits, no leading zero.
valid_ip4() {
    local a b c d o
    case "$1" in *[!0-9.]*|*..*|.*|*.) return 1 ;; esac
    IFS=. read -r a b c d <<EOF
$1
EOF
    case "$d" in *.*) return 1 ;; esac
    for o in "$a" "$b" "$c" "$d"; do
        case "$o" in ""|????*|0?*) return 1 ;; esac
        [ "$o" -le 255 ] || return 1
    done
}

# Validate the gateway $1 as a host address and derive the /24 from it. The last
# octet is the host part, so .0 and .255 are refused.
calculate_subnet() {
    valid_ip4 "$1" || return 1
    local d="${1##*.}"
    [ "$d" -gt 0 ] && [ "$d" -lt 255 ] || return 1
    IP_GW="$1"; IP_NET="${1%.*}.0/24"; IP_BEGIN="${1%.*}.10"; IP_END="${1%.*}.50"
}

check_prerequisites() {
    local b
    for b in "$IP" "$IPT" "$IW" "$HOSTAPD" "$DNSMASQ"; do
        [ -x "$b" ] || { error "$b not found"; return 1; }
    done
}

# Prints the first global /64 address on interface $1 (ULA, deprecated and
# tentative addresses don't count), nothing if there is none.
upstream_v6_addr() {
    "$IP" -6 -o addr show dev "$1" scope global 2>/dev/null \
        | $SED -n -E '/deprecated|tentative|inet6 f[cd]/d; s/.*inet6 ([0-9a-f:]+)\/64 .*/\1/p' \
        | $HEAD -n1
}

# Expand an IPv6 address to 8 zero-padded groups, colon separated.
v6_expand() {
    local a="$1" l r nl nr pad out="" g i=0
    case "$a" in
        *::*) l="${a%%::*}"; r="${a#*::}" ;;
        *)    l="$a"; r="" ;;
    esac
    nl=$($ECHO "$l" | $TR ':' ' ' | $WC -w)
    nr=$($ECHO "$r" | $TR ':' ' ' | $WC -w)
    pad=$((8 - nl - nr))
    [ "$pad" -ge 0 ] || return 1
    for g in $($ECHO "$l" | $TR ':' ' '); do out="$out $($PRINTF '%04x' "0x$g")"; done
    while [ $i -lt $pad ]; do out="$out 0000"; i=$((i + 1)); done
    for g in $($ECHO "$r" | $TR ':' ' '); do out="$out $($PRINTF '%04x' "0x$g")"; done
    $ECHO "${out# }" | $TR ' ' ':'
}

# First four groups (the /64) of an address, in v6_expand's format.
v6_first4() { v6_expand "$1" | $CUT -d: -f1-4; }

# Background loop: finds the clients' global addresses and, per address,
# installs a /128 route to ap0 and an NDP proxy entry on the upstream, so the
# upstream router finds the client behind this phone. Runs until the pid file
# is removed.
# The source is an all-nodes ping from ap0's global address: every client
# answers from its own global one. Nothing else reveals it. The prefix is
# off-link, so a client solicits only the router's link-local and never
# anything global, and ap0's neighbour table never sees the address.
# Entries are kept for the AP's lifetime: a /128 for a client that left only
# drops that client's traffic on ap0, while dropping the entry of a dozing
# client that missed one round would cut it off until the next.
# ponytail: one multicast echo every 3s. Event-driven needs a packet socket,
# which sh has not got.
v6_sync_loop() {
    local known="" bad="" a full
    while [ -f "$RUN_DIR/v6sync.pid" ]; do
        for a in $($PING -6 -w 1 -I "$IP6_GW" "ff02::1%$AP_IFACE" 2>/dev/null \
                | $SED -n 's/.* from \([0-9a-f:]*\):.*/\1/p'); do
            case "$a" in fe80:*) continue ;; esac
            case " $known $bad " in *" $a "*) continue ;; esac
            full=$(v6_expand "$a")
            case "$full" in
                "$IP6_GW") bad="$bad $a"; continue ;;
                "$IP6_P4:"*) ;;
                # Outside our /64 means a client made it up; never proxy it.
                *) bad="$bad $a"; continue ;;
            esac
            "$IP" -6 route replace "$a/128" dev "$AP_IFACE" table main 2>/dev/null
            "$IP" -6 neigh replace proxy "$a" dev "$IP6_UP_IFACE" 2>/dev/null
            known="$known $a"
            $ECHO "$a" >> "$RUN_DIR/v6clients"
        done
        $SLEEP 2
    done
}

# Undo everything setup_ipv6 did, tolerant of partial setup. $1 = upstream
# iface, $2 = ip6 forwarding and $3 = proxy_ndp value to restore (all three come
# from the state file on a later stop).
teardown_ipv6() {
    local up="$1" fwd="$2" proxy="$3" a
    del_rules -6 "$PRIO_FROM_AP" "$PRIO_TO_SUBNET" "$PRIO_V6_SINK" "$PRIO_V6_LINK"
    "$IP6T" -D FORWARD -i "$AP_IFACE" -j ACCEPT 2>/dev/null
    "$IP6T" -D FORWARD -o "$AP_IFACE" -j ACCEPT 2>/dev/null
    [ -n "$up" ] && for a in $($CAT "$RUN_DIR/v6clients" 2>/dev/null); do
        "$IP" -6 neigh del proxy "$a" dev "$up" 2>/dev/null
    done
    $RM -f "$RUN_DIR/v6clients"
    # The /128 routes go with the interface; the address is flushed here for
    # the rollback paths where ap0 lives on.
    "$IP" -6 addr flush dev "$AP_IFACE" scope global 2>/dev/null
    [ -n "$up" ] && [ -n "$proxy" ] && \
        $ECHO "$proxy" > "/proc/sys/net/ipv6/conf/$up/proxy_ndp" 2>/dev/null
    [ "$fwd" = "0" ] && $ECHO 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null
    return 0
}

# A failure after the sysctls were touched: undo it all and leave nothing in the
# IP6_* globals, so the state file records an IPv4-only AP.
v6_abort() {
    warn "IPv6: $1 - IPv4 only."
    teardown_ipv6 "$IP6_UP_IFACE" "$IP6_PREV_FWD" "$IP6_PREV_PROXY"
    IP6_NET=""; IP6_GW=""; IP6_UP_IFACE=""; IP6_PREV_FWD=""; IP6_PREV_PROXY=""
}

# Share the upstream's global /64 with the clients, but only if the upstream
# interface really has one. Never fatal: on any problem the AP stays IPv4-only.
setup_ipv6() {
    IP6_ACTIVE=0
    [ "$IPV6" = "1" ] || return 0

    local up="$UPSTREAM_IFACE_RESOLVED" c="/proc/sys/net/ipv6/conf" addr mac iid b0
    local m1 m2 m3 m4 m5 m6
    [ -n "$up" ] || { log "IPv6: upstream interface unknown - IPv4 only."; return 0; }
    addr=$(upstream_v6_addr "$up")
    [ -n "$addr" ] || { log "IPv6: $up has no global /64 prefix - IPv4 only."; return 0; }
    IP6_P4=$(v6_first4 "$addr")
    [ -n "$IP6_P4" ] || { warn "IPv6: cannot parse $addr - IPv4 only."; return 0; }
    IP6_UP_IFACE="$up"
    # Padded groups are what the comparisons want; the prefix people read in the
    # log and the status card loses the leading zeros, like ip prints it.
    IP6_NET="$($ECHO "$IP6_P4" | $SED -E 's/(^|:)0+([0-9a-f])/\1\2/g')::/64"

    # ap0's own address in the /64: EUI-64 from its MAC, so it cannot clash.
    mac=$($CAT "/sys/class/net/$AP_IFACE/address" 2>/dev/null)
    IFS=: read -r m1 m2 m3 m4 m5 m6 <<EOF
$mac
EOF
    [ -n "$m6" ] || { warn "IPv6: cannot read $AP_IFACE's MAC - IPv4 only."; return 0; }
    b0=$(( 0x$m1 ^ 2 ))
    iid=$($PRINTF '%02x%s:%sff:fe%s:%s%s' "$b0" "$m2" "$m3" "$m4" "$m5" "$m6")
    IP6_GW="${IP6_P4}:${iid}"
    log "IPv6: $up has $addr/64 - sharing $IP6_NET with the clients."

    # ap0 holds addresses but never configures itself from (rogue) RAs: we are
    # the router on this link.
    $ECHO 0 > "$c/$AP_IFACE/disable_ipv6" 2>/dev/null
    $ECHO 0 > "$c/$AP_IFACE/accept_ra" 2>/dev/null
    $ECHO 0 > "$c/$AP_IFACE/autoconf" 2>/dev/null

    # Forwarding turns interfaces with accept_ra=1 into routers that ignore RAs;
    # keep the upstream on 2 so it keeps its address and default route.
    IP6_PREV_FWD=$($CAT "$c/all/forwarding" 2>/dev/null)
    IP6_PREV_PROXY=$($CAT "$c/$up/proxy_ndp" 2>/dev/null)
    $ECHO 2 > "$c/$up/accept_ra" 2>/dev/null
    if ! $ECHO 1 > "$c/all/forwarding" 2>/dev/null \
        || ! $ECHO 1 > "$c/$up/proxy_ndp" 2>/dev/null; then
        v6_abort "could not enable forwarding/proxy_ndp"; return 0
    fi

    # /64 so dnsmasq advertises the prefix from it, nodad so it is usable at
    # once. The connected route that comes with it goes: the /64 must not be
    # on-link here, the upstream owns that route and each client gets a /128.
    "$IP" -6 addr add "$IP6_GW/64" dev "$AP_IFACE" nodad 2>/dev/null \
        || { v6_abort "could not add $IP6_GW to $AP_IFACE"; return 0; }
    "$IP" -6 route del "$IP6_NET" dev "$AP_IFACE" table main 2>/dev/null
    "$IP" -6 route replace fe80::/64 dev "$AP_IFACE" table main 2>/dev/null

    if "$IP" -6 rule add from all to "$IP6_NET" lookup main pref "$PRIO_TO_SUBNET" 2>/dev/null \
        && "$IP" -6 rule add from all iif "$up" to "$IP6_NET" blackhole pref "$PRIO_V6_SINK" 2>/dev/null \
        && "$IP" -6 rule add from all oif "$AP_IFACE" lookup main pref "$PRIO_V6_LINK" 2>/dev/null \
        && "$IP" -6 rule add from all iif "$AP_IFACE" lookup "$UPSTREAM_TABLE" pref "$PRIO_FROM_AP" 2>/dev/null \
        && "$IP6T" -I FORWARD 1 -i "$AP_IFACE" -j ACCEPT 2>/dev/null \
        && "$IP6T" -I FORWARD 1 -o "$AP_IFACE" -j ACCEPT 2>/dev/null
    then
        IP6_ACTIVE=1
    else
        v6_abort "policy rules/ip6tables failed"; return 0
    fi

    # Client discovery, in a fresh shell. The pid file exists (empty) before the
    # loop starts, since the loop runs while the file does. A forked subshell
    # would keep mksh's private copies of our stdout and stderr, which sit on
    # fds above 9 where a redirection cannot reach them, and a shell piping our
    # output would then wait for the loop to end. An exec drops them.
    : > "$RUN_DIR/v6clients"
    : > "$RUN_DIR/v6sync.pid"
    ( trap '' HUP; exec sh "$0" v6sync "$IP6_GW" "$IP6_P4" "$IP6_UP_IFACE" ) \
        </dev/null >/dev/null 2>&1 &
    $ECHO $! > "$RUN_DIR/v6sync.pid"
    return 0
}

# Helpers for the pieces every teardown path shares.
pid_alive() { [ -f "$1" ] && $KILL -0 "$($CAT "$1")" 2>/dev/null; }
# Kill and wait, up to 2s: deleting ap0 under a hostapd still tearing down its
# own interface is a race the kernel does not always win.
kill_pidfile() {
    local pid i=0
    if [ -f "$1" ]; then
        pid=$($CAT "$1")
        $KILL "$pid" 2>/dev/null
        # v6sync is this shell's own child on the rollback paths, a zombie until
        # reaped; wait is a no-op for the daemons, which are not.
        wait "$pid" 2>/dev/null
        while pid_alive "$1" && [ $i -lt 20 ]; do $SLEEP 0.1; i=$((i + 1)); done
    fi
    $RM -f "$1"
}
del_ap_iface() { "$IW" dev "$AP_IFACE" del 2>/dev/null || "$IP" link del "$AP_IFACE" 2>/dev/null; }
# A key from the state file, empty when there is none.
state() { $SED -n "s/^$1=//p" "$STATE_FILE" 2>/dev/null; }
# Delete every policy rule at the given priorities, $1 = -4 or -6.
del_rules() {
    local fam="$1" p; shift
    for p; do while "$IP" "$fam" rule del pref "$p" 2>/dev/null; do :; done; done
}

stop_daemons() {
    local d
    for d in hostapd dnsmasq v6sync; do kill_pidfile "$RUN_DIR/$d.pid"; done
    $RM -f "$RUN_DIR/hostapd.conf" "$RUN_DIR/dnsmasq.conf"
}

# Live test for the TTL target: ask the kernel to take the real rule, in a
# chain nothing jumps to, so no packet ever sees it. One test covers both a
# kernel built without the target and an iptables binary without the extension.
ttl_supported() {
    local rc
    "$IPT" -t mangle -N vap_ttl_probe 2>/dev/null
    "$IPT" -t mangle -A vap_ttl_probe -j TTL --ttl-set 64 2>/dev/null; rc=$?
    "$IPT" -t mangle -F vap_ttl_probe 2>/dev/null
    "$IPT" -t mangle -X vap_ttl_probe 2>/dev/null
    return $rc
}

# Our TTL rules live in a chain of their own, so clearing them never depends
# on knowing which subnet they were written for.
ttl_clear() {
    local ipt
    for ipt in "$IPT" "$IP6T"; do
        while "$ipt" -t mangle -D FORWARD -j vap_ttl 2>/dev/null; do :; done
        "$ipt" -t mangle -F vap_ttl 2>/dev/null
        "$ipt" -t mangle -X vap_ttl 2>/dev/null
    done
}

# $1 = IPv4 source subnet of the tethered traffic, $2 = IPv6 one (optional).
# FORWARD only sees forwarded packets, after the kernel took its one off the
# TTL, so the phone's own traffic is left alone and 64 is what leaves. Matching
# the source keeps it to outbound packets: replies on their way back to the
# clients come from the internet and keep the TTL they arrived with.
ttl_apply() {
    ttl_clear
    "$IPT" -t mangle -N vap_ttl 2>/dev/null
    "$IPT" -t mangle -A vap_ttl -s "$1" -j TTL --ttl-set 64 2>/dev/null \
        && "$IPT" -t mangle -I FORWARD -j vap_ttl 2>/dev/null \
        || { ttl_clear; return 1; }
    # IPv6 calls the same field hop limit.
    [ -n "$2" ] || return 0
    "$IP6T" -t mangle -N vap_ttl 2>/dev/null
    "$IP6T" -t mangle -A vap_ttl -s "$2" -j HL --hl-set 64 2>/dev/null \
        && "$IP6T" -t mangle -I FORWARD -j vap_ttl 2>/dev/null
    return 0
}

# Mirror of config_network, every step tolerant of what is already gone. The
# subnet comes from the state file: a restart with a new -g has already saved
# the new gateway, and the rules to remove are the old one's.
teardown() {
    local net
    net=$(state gateway); net="${net:-$IP_GW}"; net="${net%.*}.0/24"
    log "Bringing down $AP_IFACE and reverting settings..."
    stop_daemons
    del_rules -4 "$PRIO_FROM_AP" "$PRIO_TO_SUBNET"
    "$IPT" -t nat -D POSTROUTING -s "$net" ! -d "$net" -j MASQUERADE 2>/dev/null
    "$IPT" -D FORWARD -i "$AP_IFACE" -j ACCEPT 2>/dev/null
    "$IPT" -D FORWARD -o "$AP_IFACE" -j ACCEPT 2>/dev/null
    teardown_ipv6 "$(state ipv6_iface)" "$(state prev_ip6_forward)" "$(state prev_ip6_proxy_ndp)"
    "$IP" route del "$net" dev "$AP_IFACE" table main 2>/dev/null
    "$IP" route del "$net" dev "$AP_IFACE" table "$ANDROID_LOCAL_NETWORK_TABLE" 2>/dev/null
    # Restore ip_forward only if we were the ones who enabled it
    [ "$(state prev_ip_forward)" = "0" ] && $ECHO 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
    del_ap_iface
    $RM -f "$STATE_FILE"
    log "AP stopped, cleanup completed."
}

# Create the ap0 virtual interface on the physical Wi-Fi chip (both modes).
create_ap_iface() {
    log "Creating virtual AP interface '$AP_IFACE' on $PHY_IFACE..."

    del_ap_iface
    "$IW" dev "$PHY_IFACE" interface add "$AP_IFACE" type __ap \
        || { error "Failed to create $AP_IFACE - chip/driver may not support AP mode."; return 1; }
    "$IW" dev "$AP_IFACE" info >/dev/null 2>&1 || {
        error "$AP_IFACE was not created successfully"; return 1; }
    return 0
}

config_network() {
    create_ap_iface || return 1

    log "Configuring gateway address $IP_GW..."
    "$IP" link set "$AP_IFACE" down 2>/dev/null
    "$IP" addr flush dev "$AP_IFACE" 2>/dev/null
    "$IP" addr add "$IP_GW/24" dev "$AP_IFACE" || { error "Failed to assign $IP_GW"; return 1; }
    "$IP" link set "$AP_IFACE" up || { error "Failed to bring up $AP_IFACE"; return 1; }

    local prev_fwd
    prev_fwd=$($CAT /proc/sys/net/ipv4/ip_forward 2>/dev/null)
    $ECHO 1 > /proc/sys/net/ipv4/ip_forward || { error "Failed to enable IP forwarding"; return 1; }

    log "Installing routes and policy rules..."

    # Connected route in main ("replace" - restarts must not stack duplicates)
    "$IP" route replace "$IP_NET" dev "$AP_IFACE" src "$IP_GW" proto static scope link table main \
        || { error "Failed to add subnet route to main"; return 1; }

    # Mirror route in local_network table (97) so container reply packets
    # (src 172.28.0.0/16) reach VirtualAP clients via Droidspaces rule 6095.
    "$IP" route replace "$IP_NET" dev "$AP_IFACE" src "$IP_GW" proto static scope link \
        table "$ANDROID_LOCAL_NETWORK_TABLE" 2>/dev/null \
        || warn "Could not add subnet route to local_network table ($ANDROID_LOCAL_NETWORK_TABLE) - port forwards from containers may not work"

    # Return path: replies/forwards TO the AP subnet resolve via main, above
    # every netd rule (incl. VPN catch-alls)
    "$IP" rule add from all to "$IP_NET" lookup main pref "$PRIO_TO_SUBNET" 2>/dev/null \
        || warn "to-subnet rule already present"

    # Upstream steering: everything FROM the AP clients goes to the selected
    # network's table
    "$IP" rule add from all iif "$AP_IFACE" lookup "$UPSTREAM_TABLE" pref "$PRIO_FROM_AP" \
        || { error "Failed to add upstream steering rule (table $UPSTREAM_TABLE)"; return 1; }

    # Firewall: scope to ap0 only; interface-less MASQUERADE survives
    # upstream changes (Docker/LXC style)
    "$IPT" -I FORWARD 1 -i "$AP_IFACE" -j ACCEPT || { error "FORWARD -i insert failed"; return 1; }
    "$IPT" -I FORWARD 1 -o "$AP_IFACE" -j ACCEPT || { error "FORWARD -o insert failed"; return 1; }
    "$IPT" -t nat -I POSTROUTING 1 -s "$IP_NET" ! -d "$IP_NET" -j MASQUERADE \
        || { error "MASQUERADE insert failed"; return 1; }

    # IPv6 is best effort and leaves the IPv4 setup untouched when it can't run.
    setup_ipv6

    $CAT > "$STATE_FILE" <<EOF
upstream=$UPSTREAM
upstream_table=$UPSTREAM_TABLE
upstream_iface=$UPSTREAM_IFACE_RESOLVED
band=$BAND
channel=$CHANNEL
ssid=$SSID
gateway=$IP_GW
dns_servers=$DNS_SERVERS
prev_ip_forward=$prev_fwd
ipv6_net=$IP6_NET
ipv6_iface=$IP6_UP_IFACE
prev_ip6_forward=$IP6_PREV_FWD
prev_ip6_proxy_ndp=$IP6_PREV_PROXY
started=$($DATE '+%Y-%m-%d %H:%M:%S')
EOF

    log "Network configuration completed."
    return 0
}

# The WPA lines of hostapd.conf: $1 = key management, $2 = ieee80211w (PMF).
wpa_block() {
    $PRINTF 'wpa=2\nwpa_passphrase=%s\nwpa_key_mgmt=%s\nrsn_pairwise=CCMP\nieee80211w=%s' "$PASSWORD" "$1" "$2"
}

# Generate hostapd.conf. $1 = optional bridge name: when set, hostapd enslaves
# ap0 to that bridge itself (managed mode) and we run no dnsmasq/L3. Channel
# width comes from EFFECTIVE_WIDTH (set by pick_width): 20|40|80.
write_hostapd_conf() {
    local hb="$1" hw_mode extra seg0 dir vht sec
    if [ "$BAND" = "5" ]; then
        hw_mode="a"
        # 802.11n + 802.11ac. The width params are what actually open up 40/80MHz;
        # ieee80211ac alone leaves hostapd at 20MHz. vht_capab is left unset for
        # max chip compatibility (width is independent of it).
        extra="ieee80211n=1
ieee80211ac=1"
        # no_pri_sec_switch=1 skips hostapd's 20/40MHz OBSS coexistence scan
        # (the HT_SCAN state). FullMAC chips (e.g. Broadcom/brcmfmac on the
        # Galaxy S10) can't scan on an AP vif and return -95 (Not supported),
        # which aborts hostapd whenever HT40/VHT is requested. The firmware
        # self-manages the channel, so skipping the scan is safe. We set HT40+/-
        # explicitly, so the pri/sec auto-switch this also disables is unwanted
        # anyway. Only needed for HT40/VHT (20MHz has no ht_capab, no HT_SCAN).
        # Requires the hostapd-vap fork's config-parser wiring (the upstream
        # struct field exists but is otherwise unreachable from hostapd.conf).
        # width 20: no ht_capab / vht_oper_chwidth -> hostapd uses 20MHz.
        if [ "$EFFECTIVE_WIDTH" != "20" ]; then
            seg0=$(vht_seg0 "$CHANNEL"); dir=$(ht40_dir "$CHANNEL" "$seg0")
            vht=0; [ "$EFFECTIVE_WIDTH" = "80" ] && vht=1
            extra="$extra
no_pri_sec_switch=1
ht_capab=[HT40$dir]
vht_oper_chwidth=$vht"
            [ "$vht" = "1" ] && extra="$extra
vht_oper_centr_freq_seg0_idx=$seg0"
        fi
    else
        hw_mode="g"
        extra="ieee80211n=1"
        # 40MHz: the second channel sits four above the primary for channels
        # 1-7 and four below for 8-13, so the pair always stays inside the band.
        # no_pri_sec_switch for the same reason as on 5GHz above.
        if [ "$EFFECTIVE_WIDTH" = "40" ]; then
            if [ "$CHANNEL" -le 7 ]; then dir='+'; else dir='-'; fi
            extra="$extra
no_pri_sec_switch=1
ht_capab=[HT40$dir]"
        fi
    fi

    # Security block. open = no encryption (no wpa lines). PMF (ieee80211w):
    # wpa2 honors $PMF (0/1); wpa2wpa3 transition needs 1 (capable); wpa3 needs 2
    # (required). SAE (wpa3 / the wpa3 half of transition) requires hostapd built
    # with CONFIG_SAE - see scripts/build-in-container.sh.
    case "$SECURITY" in
        open)     sec="" ;;
        wpa3)     sec=$(wpa_block SAE 2) ;;
        wpa2wpa3) sec=$(wpa_block "WPA-PSK SAE" 1) ;;
        *)        [ "$PMF" = "1" ] || PMF=0; sec=$(wpa_block WPA-PSK "$PMF") ;;
    esac

    $CAT > "$RUN_DIR/hostapd.conf" <<EOF
interface=$AP_IFACE
driver=nl80211
ctrl_interface=$RUN_DIR/hostapd
${hb:+bridge=$hb}
ssid=$SSID
hw_mode=$hw_mode
channel=$CHANNEL
$extra
country_code=US
ieee80211d=1
$sec
ignore_broadcast_ssid=$HIDDEN
EOF
}

# Launch hostapd once against the current conf and confirm it stayed up. -t -f
# captures timestamped hostapd output to its own log (it daemonizes with -B, so
# the failure reason would otherwise be lost); stderr is appended too to catch
# any pre-daemonize config errors. Log is truncated per start.
#
# Liveness here is a fixed 2s sleep + PID check, not a poll. With ieee80211d=1
# hostapd can sit in COUNTRY_UPDATE ~5s, so a death *after* the 2s check (e.g. a
# late channel/width rejection by the firmware) is not caught here - the status
# command and hostapd.log surface it instead. Polling was tried and removed: it
# slowed down the common happy-path start for no real-world gain.
hostapd_try() {
    : > "$HOSTAPD_LOG" 2>/dev/null
    "$HOSTAPD" -B -t -f "$HOSTAPD_LOG" -P "$RUN_DIR/hostapd.pid" "$RUN_DIR/hostapd.conf" 2>>"$HOSTAPD_LOG" || return 1
    $SLEEP 2
    pid_alive "$RUN_DIR/hostapd.pid"
}

# Generate the conf at the picked width and launch hostapd once. pick_width has
# already resolved EFFECTIVE_WIDTH to a width the chip + channel support (warning
# on any downgrade), so the only width fallback here is 40MHz on 2.4GHz.
# $1 = optional bridge name (managed mode), passed through to write_hostapd_conf.
start_hostapd() {
    local hb="$1"
    write_hostapd_conf "$hb"
    log "Starting hostapd (${BAND}GHz ch $CHANNEL, ${EFFECTIVE_WIDTH}MHz)..."
    if hostapd_try; then
        log "hostapd running (PID $($CAT "$RUN_DIR/hostapd.pid" 2>/dev/null), ${EFFECTIVE_WIDTH}MHz)"
        return 0
    fi
    # Clean only hostapd's pidfile (the shared dnsmasq.conf must survive).
    kill_pidfile "$RUN_DIR/hostapd.pid"
    # 40MHz on 2.4GHz is the one width the radio can advertise and the firmware
    # still refuse, for instance while the phone's own Wi-Fi sits on a 20MHz
    # network on the same channel. A hotspot at 20MHz beats no hotspot.
    if [ "$BAND" != "5" ] && [ "$EFFECTIVE_WIDTH" = "40" ]; then
        warn "hostapd refused 40MHz on 2.4GHz, retrying at 20MHz."
        EFFECTIVE_WIDTH="20"
        start_hostapd "$hb"; return
    fi
    error "hostapd failed to start (check band/channel - try band 2)."
    return 1
}

# dnsmasq server= lines from a comma separated list, blanks and empties dropped.
dns_lines() {
    $ECHO "$1" | $TR -d '[:space:]' | $TR ',' '\n' | $SED -n '/./s/^/server=/p'
}

start_services() {
    log "Generating service configs (band ${BAND}GHz, channel $CHANNEL)..."

    # One server= line per upstream resolver.
    local dns_config
    dns_config=$(dns_lines "$DNS_SERVERS")

    # Router advertisements (SLAAC) + IPv6 DNS, only when setup_ipv6 got going.
    local v6_config=""
    if [ "$IP6_ACTIVE" = "1" ]; then
        # off-link: clients send everything (even to the upstream LAN's own
        # addresses) to us instead of trying to resolve them on ap0.
        v6_config="enable-ra
dhcp-range=${IP6_P4}::,ra-only,off-link,64,12h
dhcp-option=option6:dns-server,[$IP6_GW]"
    fi

    $CAT > "$RUN_DIR/dnsmasq.conf" <<EOF
interface=$AP_IFACE
bind-interfaces
except-interface=lo
listen-address=$IP_GW
dhcp-range=$IP_BEGIN,$IP_END,12h
dhcp-option=option:router,$IP_GW
dhcp-option=option:dns-server,$IP_GW
$v6_config
dhcp-leasefile=$RUN_DIR/dnsmasq.leases
no-resolv
$dns_config
no-hosts
pid-file=$RUN_DIR/dnsmasq.pid
user=root
log-facility=$DNSMASQ_LOG
log-dhcp
EOF

    start_hostapd "" || return 1

    log "Starting dnsmasq..."
    : > "$DNSMASQ_LOG" 2>/dev/null
    # dnsmasq's parent only exits once the daemon has written its pid file and
    # is serving, so a zero exit here is the liveness check.
    "$DNSMASQ" -C "$RUN_DIR/dnsmasq.conf" || { error "dnsmasq failed to start"; return 1; }
    log "dnsmasq running (PID $($CAT "$RUN_DIR/dnsmasq.pid" 2>/dev/null))"
}

# Run $@ until it succeeds, six tries 0.3s apart: a freshly created link
# answers EPERM for a moment. The last try is loud, so the error surfaces.
retry() {
    local i=0
    while [ $i -lt 5 ]; do "$@" 2>/dev/null && return 0; i=$((i + 1)); $SLEEP 0.3; done
    "$@"
}

# Host bridge and veth, busybox ip since Android's own EPERMs on these.
del_bridge() {
    "$BUSYBOX" ip link del "$VAP_VETH_HOST" 2>/dev/null
    "$BUSYBOX" ip link del "$VAP_BRIDGE" 2>/dev/null
}

# OpenWrt auto-provisioning: a LAN on VAP_PORT with its own DHCP + NAT out WAN.
provision_openwrt() {
    log "Provisioning OpenWrt LAN ($IP_GW) on $VAP_PORT..."

    ds_run uci set network.vaplan=interface
    ds_run uci set network.vaplan.device="$VAP_PORT"
    ds_run uci set network.vaplan.proto=static
    ds_run uci set network.vaplan.ipaddr="$IP_GW"
    ds_run uci set network.vaplan.netmask=255.255.255.0
    # A /64 from the router's ULA. Without a ULA or an IPv6 upstream this is
    # inert, so it is safe on an OpenWrt that has neither.
    ds_run uci set network.vaplan.ip6assign=64
    # netifd numbers those /64s in interface-name order and renumbers them all
    # whenever an interface is added, so any LAN that sorts before vaplan (the
    # image's own Containers does) moves every hotspot client to a new subnet.
    # Pin it to the IPv4 subnet's number, 192.168.42.1 gets <ula>:42::/64. A
    # hint set by hand is kept, and a prefix too small for it makes netifd fall
    # back to its own pick.
    ds_run uci -q get network.vaplan.ip6hint >/dev/null 2>&1 ||
        ds_run uci set network.vaplan.ip6hint="$($ECHO "$IP_GW" | $CUT -d. -f3)"
    ds_run uci commit network

    ds_run uci set dhcp.vaplan=dhcp
    ds_run uci set dhcp.vaplan.interface=vaplan
    ds_run uci set dhcp.vaplan.start=100
    ds_run uci set dhcp.vaplan.limit=150
    ds_run uci set dhcp.vaplan.leasetime=12h
    # Hand hotspot clients IPv6 too. ra_default 1: announce ourselves as the
    # default router even though the only prefix is a ULA, since the upstream
    # is NAT66 and never delegates a public one.
    ds_run uci set dhcp.vaplan.ra=server
    ds_run uci set dhcp.vaplan.dhcpv6=server
    ds_run uci set dhcp.vaplan.ra_default=1
    ds_run uci commit dhcp

    ds_run /etc/init.d/network reload >/dev/null 2>&1
    ds_run /etc/init.d/dnsmasq restart >/dev/null 2>&1
    # odhcpd sends the router advertisements; absent on images without IPv6.
    ds_run /etc/init.d/odhcpd reload >/dev/null 2>&1

    # Most Android kernels lack nf_tables (fw4 fails) but have x_tables, so we
    # rely on iptables-legacy here.
    ds_run sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1

    if ds_run iptables-legacy --version >/dev/null 2>&1; then
        # iptables-legacy world. If the container ships the iptables firewall
        # (fw3) let it own NAT via its zones - our OpenWrt image puts 'vaplan'
        # in an isolated 'guest' zone forwarded out the masqueraded wan zone,
        # so a reload is all it takes. Otherwise install MASQUERADE ourselves.
        if ds_run ls /etc/init.d/firewall >/dev/null 2>&1; then
            ds_run /etc/init.d/firewall reload >/dev/null 2>&1
            log "OpenWrt firewall (fw3) reloaded - '$VAP_PORT' masqueraded out the wan zone."
        else
            ds_run iptables-legacy -t nat -D POSTROUTING -s "$IP_NET" ! -d "$IP_NET" -j MASQUERADE 2>/dev/null
            if ds_run iptables-legacy -t nat -A POSTROUTING -s "$IP_NET" ! -d "$IP_NET" -j MASQUERADE; then
                log "OpenWrt NAT installed (iptables-legacy MASQUERADE)."
            else
                warn "OpenWrt: failed to add iptables-legacy MASQUERADE rule."
            fi
        fi
    elif ds_run nft list ruleset >/dev/null 2>&1; then
        ds_run /etc/init.d/firewall reload >/dev/null 2>&1
        warn "OpenWrt is using nftables/fw4 - make sure '$VAP_PORT' sits in a masqueraded firewall zone."
    else
        warn "OpenWrt has no iptables-legacy and no working nftables."
        warn "Clients will get an IP but NO internet. Inside the container, run:"
        warn "    opkg update && opkg install iptables-zz-legacy firewall"
    fi
    return 0
}

# Wire ap0 -> VAP_BRIDGE -> veth -> container. No L3 on our side.
config_network_bridged() {
    local pid gw_mac
    pid=$(ds_container_pid "$CONTAINER")
    [ -z "$pid" ] && { error "Container '$CONTAINER' is not running."; return 1; }
    log "Managed mode: wiring $AP_IFACE to container '$CONTAINER' (PID $pid) via $VAP_BRIDGE."

    create_ap_iface || return 1

    del_bridge   # a stale one from a previous run

    # Neutral host bridge (no IP - the container owns all L3).
    "$IP" link add name "$VAP_BRIDGE" type bridge || { error "Failed to create $VAP_BRIDGE"; return 1; }
    # No IP has to hold for IPv6 too: Android leaves accept_ra at 2, so the host
    # would take an address and a default route from the container's own RAs.
    $ECHO 1 > "/proc/sys/net/ipv6/conf/$VAP_BRIDGE/disable_ipv6" 2>/dev/null
    retry "$IP" link set "$VAP_BRIDGE" up || { error "Failed to bring up $VAP_BRIDGE"; return 1; }

    # veth: host side joins the bridge, peer crosses into the container.
    "$IP" link add "$VAP_VETH_HOST" type veth peer name "$VAP_VETH_PEER" \
        || { error "Failed to create veth pair"; return 1; }
    "$IP" link set "$VAP_VETH_HOST" master "$VAP_BRIDGE" \
        || { error "Failed to enslave $VAP_VETH_HOST to $VAP_BRIDGE"; return 1; }
    retry "$IP" link set "$VAP_VETH_HOST" up || { error "Failed to bring up $VAP_VETH_HOST"; return 1; }

    "$IP" link set "$VAP_VETH_PEER" netns "$pid" \
        || { error "Failed to move veth into container netns"; return 1; }
    ds_run ip link set "$VAP_VETH_PEER" name "$VAP_PORT" \
        || { error "Failed to rename veth to $VAP_PORT inside container"; return 1; }
    # Before the link comes up, so the random MAC is never seen on the LAN and
    # an EUI-64 link-local address is built from this one.
    if [ -n "$GW_MAC" ]; then
        # ap0 is a port on the same bridge, and a bridge keeps frames for its
        # ports' own MACs, so a gateway sharing ap0's would never see a client.
        if [ "$($ECHO "$GW_MAC" | $TR 'A-F' 'a-f')" = "$($CAT "/sys/class/net/$AP_IFACE/address" 2>/dev/null)" ]; then
            warn "The gateway MAC $GW_MAC is the hotspot radio's own, keeping a random one."
        elif ds_run ip link set "$VAP_PORT" address "$GW_MAC"; then
            log "Gateway MAC fixed at $GW_MAC."
        else
            warn "Could not set the gateway MAC to $GW_MAC, keeping a random one."
        fi
    fi
    ds_run ip link set "$VAP_PORT" up || warn "Could not bring up $VAP_PORT inside container."

    # The container owns L3. Auto-provision OpenWrt; otherwise hand it over.
    if ds_is_openwrt; then
        provision_openwrt || warn "OpenWrt provisioning hit issues - check the container."
    else
        log "Container is not OpenWrt - delivered $VAP_PORT. The container must"
        log "configure it (assign an IP, run DHCP + NAT) on its own."
    fi

    # Read back rather than assumed, so status shows the random one too.
    gw_mac=$(ds_run cat "/sys/class/net/$VAP_PORT/address" 2>/dev/null)

    $CAT > "$STATE_FILE" <<EOF
mode=bridged
container=$CONTAINER
bridge=$VAP_BRIDGE
gw_mac=$gw_mac
band=$BAND
channel=$CHANNEL
ssid=$SSID
gateway=$IP_GW
started=$($DATE '+%Y-%m-%d %H:%M:%S')
EOF

    log "Managed network wiring completed."
    return 0
}

start_services_bridged() {
    log "Starting hostapd (managed/bridged mode)..."
    # No bridge= in the conf: ap0 is enslaved here, only once hostapd is up.
    start_hostapd "" || return 1
    retry "$IP" link set "$AP_IFACE" master "$VAP_BRIDGE" \
        || { error "Failed to enslave $AP_IFACE to $VAP_BRIDGE."; return 1; }
    log "$AP_IFACE bridged into $VAP_BRIDGE - clients now live on the container's LAN."
    return 0
}

teardown_bridged() {
    log "Tearing down managed (bridged) AP..."

    stop_daemons
    del_ap_iface
    # Deleting the veth also removes VAP_PORT inside the container; its uci LAN
    # config is left intact.
    del_bridge

    $RM -f "$STATE_FILE"
    log "Managed AP stopped (container '$CONTAINER' left running)."
}

cmd_start() {
    # One session per file: nothing reads ap.log but a person with a shell, and
    # without this it grows for as long as the phone lives.
    : > "$LOG_FILE"
    [ -z "$SSID" ] && { error "SSID not set (use -s or save a config first)"; exit 1; }
    # Open networks carry no passphrase; WPA modes use a WPA-PSK/SAE passphrase,
    # which the standard (and hostapd) bound to 8-63 characters.
    local plen ttl_src ttl_src6 d
    calculate_subnet "$IP_GW" || { error "Invalid gateway IP address: '$IP_GW'"; exit 1; }
    # Checked here, before save_conf: dnsmasq would only refuse a bad entry after
    # hostapd is up, and the value would already be saved for the next start.
    for d in $($ECHO "$DNS_SERVERS" | $TR -d '[:space:]' | $TR ',' ' '); do
        valid_ip4 "$d" || { error "Invalid DNS server: '$d'"; exit 1; }
    done
    [ "$HIDDEN" = "1" ] || HIDDEN=0
    if [ "$SECURITY" != "open" ]; then
        plen=$($PRINTF %s "$PASSWORD" | $WC -c)
        [ "$plen" -ge 8 ] && [ "$plen" -le 63 ] || { error "Password must be 8-63 characters."; exit 1; }
    fi

    if [ -n "$CHANNEL" ]; then
        case "$CHANNEL" in
            *[!0-9]*)
                warn "Channel '$CHANNEL' is not a valid number. Resetting to auto."
                CHANNEL=""
                ;;
            *)
                if [ "$BAND" = "5" ]; then
                    if [ "$CHANNEL" -lt 36 ]; then
                        warn "Channel $CHANNEL is invalid for 5GHz band. Resetting to auto."
                        CHANNEL=""
                    fi
                else
                    if [ "$CHANNEL" -lt 1 ] || [ "$CHANNEL" -gt 14 ]; then
                        warn "Channel $CHANNEL is invalid for 2.4GHz band. Resetting to auto."
                        CHANNEL=""
                    fi
                fi
                ;;
        esac
    fi

    # Persist settings now, before pick_channel mutates BAND/CHANNEL and
    # before anything can fail - a failed attempt must not lose the config.
    save_conf

    # Tear down any previous AP, and daemons orphaned by one that left no state.
    [ -f "$STATE_FILE" ] && { log "Existing AP state found - restarting..."; cmd_stop; }
    stop_daemons

    check_prerequisites || exit 1

    if [ -n "$CONTAINER" ]; then
        if [ -z "$(ds_container_pid "$CONTAINER")" ]; then
            error "Container '$CONTAINER' is not running - start it first."
            teardown_bridged; exit 1
        fi
        pick_channel
        pick_width
        trap 'teardown_bridged; exit 1' INT TERM

        if ! config_network_bridged; then teardown_bridged; exit 1; fi
        if ! start_services_bridged; then teardown_bridged; exit 1; fi

        log "VirtualAP is ACTIVE (managed by container '$CONTAINER')!"
        log "  SSID    : $SSID (${BAND}GHz, channel $CHANNEL, ${EFFECTIVE_WIDTH}MHz)"
        log "  Upstream: container '$CONTAINER' via $VAP_BRIDGE -> $VAP_PORT"
        log "  LAN     : served by the container ($IP_GW)"
        # The container NATs the clients, so their traffic reaches the host
        # from Droidspaces' own NAT subnets.
        ttl_src="$DS_NAT_NET"; ttl_src6="$DS_NAT_NET6"
    else
        resolve_upstream || exit 1
        # A -d with no address in it (empty, or separators only) means the default
        # pair; decided here so dnsmasq and the state file agree. ap.conf keeps the
        # value as given.
        [ -n "$(dns_lines "$DNS_SERVERS")" ] || DNS_SERVERS="$DNS_DEFAULT"
        pick_channel
        pick_width
        trap 'teardown; exit 1' INT TERM

        if ! config_network; then teardown; exit 1; fi
        if ! start_services; then teardown; exit 1; fi

        log "VirtualAP is ACTIVE!"
        log "  SSID    : $SSID (${BAND}GHz, channel $CHANNEL, ${EFFECTIVE_WIDTH}MHz)"
        log "  Gateway : $IP_GW (static - never changes)"
        log "  Upstream: ${UPSTREAM_IFACE_RESOLVED:-$UPSTREAM} (table $UPSTREAM_TABLE)"
        if [ "$IP6_ACTIVE" = "1" ]; then
            log "  IPv6    : $IP6_NET shared from $IP6_UP_IFACE (global, NDP proxy, no NAT)"
        else
            log "  IPv6    : off"
        fi
        ttl_src="$IP_NET"; ttl_src6=""
        [ "$IP6_ACTIVE" = "1" ] && ttl_src6="$IP6_NET"
    fi

    # Clear first, so switching the option off takes effect on a restart.
    ttl_clear
    if [ "$TTL_FIX" = "1" ]; then
        if ttl_apply "$ttl_src" "$ttl_src6"; then
            log "  TTL fix : forwarded packets leave with TTL 64"
        else
            warn "TTL fix is not available: the kernel or iptables lacks the TTL target. Continuing without it."
        fi
    fi
}

cmd_stop() {
    ttl_clear
    if $GREP -q '^mode=bridged' "$STATE_FILE" 2>/dev/null; then
        teardown_bridged
    else
        teardown
    fi
}

cmd_status() {
    local running=0 dnsmasq_state="dead" clients=0 mode="routed" width="" conf="$RUN_DIR/hostapd.conf"
    if [ -f "$STATE_FILE" ]; then
        $GREP -q '^mode=bridged' "$STATE_FILE" && mode="bridged"
        pid_alive "$RUN_DIR/hostapd.pid" && running=1
        # DHCP/DNS are the container's in bridged mode, not ours.
        if [ "$mode" = "bridged" ]; then dnsmasq_state="container"
        elif pid_alive "$RUN_DIR/dnsmasq.pid"; then dnsmasq_state="running"; fi
        # hostapd's own list, not the driver's: MediaTek's gen4m has no
        # dump_station, so `iw station dump` is always empty there.
        clients=$(hostapd_cli -p "$RUN_DIR/hostapd" -i "$AP_IFACE" list_sta 2>/dev/null | $GREP -c ':')
    fi

    $ECHO "running=$running"
    $ECHO "mode=$mode"
    $ECHO "dnsmasq=$dnsmasq_state"
    $ECHO "clients=$clients"
    if [ "$running" = "1" ]; then
        # Actual channel width, read live from the radio (iw) so it reflects any
        # firmware downgrade - FullMAC same-channel concurrency can force 20MHz
        # regardless of what hostapd.conf requested. Fall back to the conf only
        # when iw reports no width line.
        width=$("$IW" dev "$AP_IFACE" info 2>/dev/null \
            | $SED -n 's/.*width: \([0-9]\{2,3\}\) MHz.*/\1/p' | $HEAD -n1)
        if   [ -n "$width" ]; then $ECHO "width=$width"
        elif $GREP -q '^vht_oper_chwidth=1' "$conf"; then $ECHO "width=80"
        elif $GREP -q '^ht_capab=\[HT40' "$conf"; then $ECHO "width=40"
        else $ECHO "width=20"; fi
        # Active security mode, from the live conf's key-mgmt line.
        if   ! $GREP -q '^wpa=' "$conf"; then $ECHO "security=open"
        elif $GREP -q '^wpa_key_mgmt=WPA-PSK SAE' "$conf"; then $ECHO "security=wpa2wpa3"
        elif $GREP -q '^wpa_key_mgmt=SAE' "$conf"; then $ECHO "security=wpa3"
        else $ECHO "security=wpa2"; fi
    fi
    # gateway/ssid/etc. come from the state file (IP_GW in both routed + bridged)
    $GREP -E '^(ssid|band|channel|upstream|upstream_table|upstream_iface|gateway|gw_mac|dns_servers|container|started)=' "$STATE_FILE" 2>/dev/null \
        || $ECHO "gateway=$IP_GW"
}

cmd_interfaces() {
    # Candidate upstreams as "name:ip" lines for the app (ap0/lo excluded).
    local name addr path
    for path in /sys/class/net/*; do
        name="${path##*/}"
        case "$name" in
            lo|"$AP_IFACE") continue ;;
        esac
        addr=$("$IP" -4 -o addr show dev "$name" 2>/dev/null \
            | $SED -n 's/.*inet \([0-9.]*\).*/\1/p' | $HEAD -n1)
        $ECHO "$name:${addr:-no-ip}"
    done
}

cmd_containers() {
    # Running Droidspaces containers, one name per line. Empty = not installed or
    # nothing running; the app uses this to show/hide the container UI.
    ds_list | $SED 's/=[0-9]*$//'
}

cmd_caps() {
    # 5GHz channel-width capabilities of the Wi-Fi chip, for the app to grey out
    # unsupported width options. 20MHz is always available (not reported).
    local ht40=0 vht=0
    phy_supports_ht40 && ht40=1
    phy_supports_vht  && vht=1
    $ECHO "ht40=$ht40"
    $ECHO "vht=$vht"
    if ttl_supported; then $ECHO "ttl=1"; else $ECHO "ttl=0"; fi
    $ECHO "mac=$(wifi_mac)"
}

print_usage() {
    $CAT <<EOF
Usage: $SCRIPT_NAME <start|stop|status|interfaces|containers|caps> [options]

start options:
  -s <SSID>      AP name
  -p <password>  AP password (8-63 chars)
  -o <iface>     Upstream interface, or 'auto' (default: auto)
  -b <band>      2 = 2.4GHz (default), 5 = 5GHz
  -c <channel>   Channel (auto-picked / STA-followed when omitted)
  -W <width>     Channel width: auto (default), 20, 40, or 80 (80 is 5GHz
                 only; on 2.4GHz auto means 20)
  -g <gateway>   Gateway IP (default: $GW_DEFAULT)
  -d <dns>       Comma-separated upstream DNS servers (default: $DNS_DEFAULT)
  -w <iface>     Physical WiFi interface (default: wlan0)
  -H <0|1>       Hide SSID (0 = visible [default], 1 = hidden)
  -A <mode>      Security: open, wpa2 (default), wpa2wpa3, wpa3
  -M <0|1>       Protected Management Frames for wpa2 (0=off [default],
                 1=on); forced on for wpa2wpa3, required for wpa3
  -K <container> Managed mode: hand the AP's LAN to a Droidspaces
                 container (it owns DHCP/DNS/NAT). Disables -o/-g/-d.
  -m <mac>       Managed mode: MAC of the container's LAN port, the
                 clients' gateway (empty = a new random one on every
                 start [default]).
  -T <0|1>       TTL fix: forwarded packets leave with TTL 64, so they
                 look like the phone's own (0=off [default], 1=on).
                 Needs the kernel's TTL target; skipped when missing.
  -6 <0|1>       IPv6 for clients when the upstream has a global /64
                 prefix: they get global addresses from it, routed with
                 an NDP proxy, no NAT (0=off, 1=on [default]). Routed
                 mode only.

Saved settings in $CONF_FILE are reused when flags are omitted.
EOF
}

case "$1" in -h|--help|help|"") print_usage; exit 0 ;; esac
[ "$($ID -u)" -eq 0 ] || { error "This script must be run as root."; exit 1; }

COMMAND="$1"; shift

load_conf

while getopts "s:p:o:b:c:W:w:g:d:H:A:M:K:T:m:6:" opt 2>/dev/null; do
    # hostapd.conf and run.state are line based: a value with a line break in
    # it would become a directive of its own.
    [ "$($PRINTF %s "$OPTARG" | $WC -l)" -eq 0 ] \
        || { error "-$opt cannot contain a line break."; exit 1; }
    case $opt in
        s) SSID="$OPTARG" ;;
        p) PASSWORD="$OPTARG" ;;
        o) UPSTREAM="$OPTARG" ;;
        b) BAND="$OPTARG" ;;
        c) CHANNEL="$OPTARG" ;;
        W) WIDTH="$OPTARG" ;;
        w) PHY_IFACE="$OPTARG" ;;
        g) IP_GW="${OPTARG:-$GW_DEFAULT}" ;;
        d) DNS_SERVERS="$OPTARG" ;;
        H) HIDDEN="$OPTARG" ;;
        A) SECURITY="$OPTARG" ;;
        M) PMF="$OPTARG" ;;
        K) CONTAINER="$OPTARG" ;;
        T) TTL_FIX="$OPTARG" ;;
        m) GW_MAC="$OPTARG" ;;
        6) IPV6="$OPTARG" ;;
        *) print_usage; exit 1 ;;
    esac
done

case "$COMMAND" in
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    status)     cmd_status ;;
    interfaces) cmd_interfaces ;;
    containers) cmd_containers ;;
    caps)       cmd_caps ;;
    # Internal, started by setup_ipv6 with the gateway address, the padded /64
    # and the upstream interface. Not for people, so not in the usage text.
    v6sync)     IP6_GW="$1"; IP6_P4="$2"; IP6_UP_IFACE="$3"; v6_sync_loop ;;
    *) error "Unknown command: $COMMAND"; print_usage; exit 1 ;;
esac
